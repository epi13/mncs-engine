mncs 0.10;

// Minimized reproducer for ENG-PRESSURE-0002: MNCS has no floating-point
// type, so 1.5 * 2.25 must be spelled as Q16.16 narrow((a *% b)) with an
// explicit truncation contract. Desired (unexpressible):
//   fn fmul(a: f64, b: f64) -> f64 { return a * b; }
module pressure.fixed_point;

// Truncating Q16.16 multiply, self-contained (cf. engine.math.scalar).
fn fp_mul(a: i64, b: i64) -> (result: i64) {
    let q: i64 = (a *% b) / 65536;
    let r: i64 = (a *% b) % 65536;
    let z: i64 = 0;
    let up: i64 = select(((a *% b) < z) && (r != z), 1, 0);
    return q +% up;
}

// 1.5 * 2.25 = 3.375, i.e. 221184 in Q16.16.
fn probe_fmul() -> (result: i64) {
    return fp_mul(98304, 147456);
}
